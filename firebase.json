{
  "apphosting": [
    {
      "backendId": "studio",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "uploads",
        ".env",
        ".env.*"
      ]
    },
    {
      "backendId": "meeting-minutes",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions",
        "uploads"
      ]
    }
  ],
  "hosting": [
    {
      "target": "minutesflow",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/sw.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" },
            { "key": "Service-Worker-Allowed", "value": "/" }
          ]
        },
        {
          "source": "/manifest.webmanifest",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "run": {
            "serviceId": "meeting-minutes",
            "region": "asia-southeast1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],

  "firestore": {
    "rules": "firestore.rules"
  }
}
